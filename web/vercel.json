{
  "rewrites": [
    { "source": "/p", "destination": "/p/index.html" },
    { "source": "/p/:token", "destination": "/p/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
