<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      READ_SMS / RECEIVE_SMS: ingest wallet and bank confirmation messages for the
      on-device transaction ledger (money management). SEND_SMS is not used.
      Details: docs/play-store-sms-permission-review.md
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Line numbers on dual-SIM (API 26+); paired with READ_PHONE_STATE for wallet matching. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+: hide other apps' overlays while LipaBill is visible (tapjacking). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Metrics only: do not declare the advertising ID even if Firebase merges it. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <!-- OEM survival: request unrestricted battery so Accessibility stays bound. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Firebase Analytics (metrics only) + ML Kit model delivery -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Telephony stays optional so Wi-Fi tablets can install. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!--
      Optional for Play availability (Desktop / XR / some tablets). Non-handheld
      installs are still refused at runtime by HandheldDeviceGate.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.software.app_widgets" android:required="false" />

    <queries>
        <package android:name="com.android.settings" />
        <package android:name="com.android.settings.intelligence" />
        <!-- OEM survival deep-links (Device Care / battery / autostart). -->
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.transsion.phonemanager" />
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="com.android.settings.action.SETTINGS_SEARCH" />
        </intent>
        <!-- Venue directions: Google Maps, or any app that handles geo: searches. -->
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- System contact picker (one number; no READ_CONTACTS). -->
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
        </intent>
        <!-- Social profile QR: prefer the native app when installed. -->
        <package android:name="com.instagram.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.instagram.barcelona" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="instagram" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="twitter" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
    </queries>

    <!-- taskAffinity="": no other app can declare our affinity and slip its
         activity into LipaBill's task (StrandHogg-style task hijacking). -->
    <application
        android:name=".LipaBillApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:taskAffinity=""
        android:theme="@style/Theme.LipaBill">

        <!-- Metrics only: disable advertising ID collection -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <!-- Prefetch unbundled ML Kit models after a Play install (QR + ticket OCR). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode,ocr" />

        <!-- Omit screenOrientation. portrait and fullUser make some devices
             rewrite the system Auto-rotate toggle when this activity opens. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LipaBill"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustNothing"
            android:enableOnBackInvokedCallback="false"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Payment alerts open the matching receipt (custom action + extras). -->
            <intent-filter>
                <action android:name="com.lipabill.app.action.OPEN_RECEIPT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Same receipt target as a browsable custom-scheme URI. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lipabill" android:host="receipt" android:pathPrefix="/" />
            </intent-filter>
            <!-- Pay code — legacy custom scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lipabill" android:host="p" android:pathPrefix="/" />
            </intent-filter>
            <!-- Pay code — HTTPS App Links (assetlinks at https://lipabill.app/.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="lipabill.app"
                    android:pathPrefix="/p/" />
            </intent-filter>
            <!-- Apple Wallet passes by MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.apple.pkpass" />
                <data android:mimeType="application/vnd.apple.pkpasses" />
                <data android:mimeType="application/vnd-apple.pkpass" />
            </intent-filter>
            <!-- content:// .pkpass shares whose type says they are passes. No path rules here:
                 Android ignores paths in a filter without a host, and lint fails on them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:mimeType="application/vnd.apple.pkpass" />
                <data
                    android:scheme="content"
                    android:mimeType="application/vnd.apple.pkpasses" />
            </intent-filter>
            <!-- Ticket PDFs and photos shared from mail / WhatsApp / Files. SEND only: no VIEW,
                 so LipaBill is not an "Open with" choice for every photo on the phone.
                 Each file is read on-device and goes through review before it is saved. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- content:// shares typed as zip whose name ends in .pkpass. Any
                 provider authority (host="*") so the path rules actually apply. Paths must
                 start with "/" for Play's deep-link checker; pathPattern stops at dots so
                 several depths are listed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="application/zip"
                    android:pathSuffix=".pkpass" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="application/x-zip-compressed"
                    android:pathSuffix=".pkpass" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:pathPattern="/.*\\.pkpass" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:pathPattern="/.*\\..*\\.pkpass" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:pathPattern="/.*\\..*\\..*\\.pkpass" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:pathPattern="/.*\\..*\\..*\\..*\\.pkpass" />
            </intent-filter>
        </activity>

        <!-- Privacy Dashboard and the app's permission page open this to explain access. -->
        <activity
            android:name=".ui.permissions.DataAccessRationaleActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:theme="@style/Theme.LipaBill">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE_FOR_PERIOD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Shares one Wrapped story card image at a time, from cache/wrapped only. -->
        <provider
            android:name=".ui.analytics.WrappedFileProvider"
            android:authorities="${applicationId}.wrapped"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/wrapped_paths" />
        </provider>

        <!-- Home-screen widget: safe to spend + balance, masked until the eye is tapped. -->
        <receiver
            android:name=".widget.BalanceWidget"
            android:exported="true"
            android:label="@string/widget_safe_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
        </receiver>

        <receiver
            android:name=".data.sms.MpesaSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Re-plan pass reminders after clock/timezone changes or an app update. -->
        <receiver
            android:name=".tickets.PassReminderRecheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ussd.UssdAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ussd_accessibility_service" />
        </service>
    </application>
</manifest>
